{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fleet-console",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-07",
  "upload_source_maps": true,
  "vars": {
    "API_ORIGIN": "https://fleet-demo.165-232-96-216.sslip.io",
    // Staging rejects browser origins other than its own. Remove this once the
    // deployed origin is in the backend's WS_ALLOWED_ORIGINS.
    "WS_ORIGIN_REWRITE": "true",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
