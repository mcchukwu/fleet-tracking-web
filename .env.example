# Same-origin by default. Leave VITE_API_BASE empty so /api is served by the dev proxy.
VITE_API_BASE=
VITE_MAP_PROVIDER=maplibre
VITE_MOCK=0
VITE_DEMO_HINTS=0
# Optional override for the dev proxy; defaults to staging.
VITE_PROXY_TARGET=
# Map basemap. OpenFreeMap is the default; override with any MapLibre style URL.
VITE_MAP_STYLE_URL_LIGHT=
VITE_MAP_STYLE_URL_DARK=
# Satellite is offered only when the raster template and its required credit are both set.
# Example template: https://tiles.example.com/satellite/{z}/{x}/{y}.jpg
VITE_SATELLITE_TILES_URL=
VITE_SATELLITE_ATTRIBUTION=
# Optional licence link; without it the credit renders as text rather than a link.
VITE_SATELLITE_ATTRIBUTION_HREF=
# Glyphs used by the satellite style for labels; defaults to the OpenFreeMap font endpoint.
VITE_MAP_GLYPHS_URL=
