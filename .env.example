# Same-origin by default. Leave VITE_API_BASE empty so /api is served by the dev proxy.
VITE_API_BASE=
VITE_MAP_PROVIDER=maplibre
VITE_MOCK=0
VITE_DEMO_HINTS=0
# Optional override for the dev proxy; defaults to staging.
VITE_PROXY_TARGET=
# Standard basemap. OpenFreeMap is the default; override with any MapLibre style URL.
VITE_MAP_STYLE_URL_LIGHT=
VITE_MAP_STYLE_URL_DARK=
# MapTiler Streets and Satellite. Put the key in .env.local; never commit it.
# Without a key the picker offers only the standard "Map" style.
VITE_MAPTILER_API_KEY=
# Optional glyph override for the standard style only. MapTiler styles bring their own.
VITE_MAP_GLYPHS_URL=
# Offline basemap: a self-hosted PMTiles file (see docs/offline.md). Empty means online-only.
VITE_MAP_PMTILES_URL=
# Optional override for the self-hosted glyph and sprite roots.
VITE_MAP_SPRITE_URL=
# Enable the service worker in development (cannot be combined with VITE_MOCK=1).
VITE_SW_DEV=0
# Expose window.__FLEET_DEBUG__ in production builds for the PWA suite.
VITE_FLEET_DEBUG=0
